# Supabase DB key — server-side only, NEVER exposed to the MCP host.
# PREFER a least-privilege, SELECT-only JWT (role=reporting_readonly) over the full
# service_role key. Apply sql/2026-08-26_reporting_readonly_role.sql, then mint a JWT
# with {"role":"reporting_readonly"} signed with the project JWT secret and put it here.
# The server logs a warning at boot if it detects a full service_role key.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_DATA_KEY=<reporting_readonly-jwt>
SUPABASE_OAUTH_STORAGE_KEY=<mcp_oauth_writer-jwt>
SUPABASE_AUDIT_KEY=<mcp_audit_writer-jwt>
# Legacy fallback during migration only; remove after SUPABASE_DATA_KEY is live.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key (public — safe to expose). REQUIRED when the DB key above is a
# custom-role JWT like reporting_readonly: it becomes the gateway apikey while the DB
# key rides as the bearer. Leave empty only if the DB key is a real service_role key.
SUPABASE_ANON_KEY=<anon-or-sb_publishable_key>

# Access control for STATIC-TOKEN mode. Do not use these on the OAuth deployment.
# Either set one admin token (all campuses):
MCP_ADMIN_TOKEN=<long-random-faculty-admin-token>   # >=24 chars, e.g. `secrets.token_urlsafe(24)`
# ...and/or a JSON map of per-faculty tokens to their allowed campuses.
# Each entry may carry an optional "expires" (ISO date/datetime) for revocation-by-date:
# MCP_TOKENS={"tok_indore_xyz":{"name":"Indore TNP","campuses":["indore"],"expires":"2026-12-31"},"tok_all":{"name":"Programme Office","campuses":null}}
# ALLOW_WEAK_TOKENS=false   # set true only to permit tokens <24 chars (dev/legacy)

# Interactive Google OAuth (recommended for Codex and other hosted MCP clients).
# Both Google values are required together. Configure the Google redirect URI as
# https://<your-mcp-host>/auth/callback.
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
OAUTH_JWT_SIGNING_KEY=<long-stable-random-secret>
OAUTH_STORAGE_ENCRYPTION_KEY=<independent-long-random-secret>
OAUTH_ALLOWED_DOMAINS=jaipuria.ac.in
OAUTH_REDIRECT_HOSTS=<approved-hosted-client.example>
OAUTH_ALLOW_CROSS_CLIENT_PKCE=false
# Default only for other allowed domains; Jaipuria IDs always get all campuses.
OAUTH_DEFAULT_CAMPUSES=none
# Optional grants for external accounts. Jaipuria grants do not narrow access.
# MCP_FACULTY={"external@example.com":{"name":"External Reviewer","campuses":["jaipur"]}}

# Identity
MCP_SERVER_NAME=jaipuria-moodle-mcp
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_BASE_URL=https://moodle-mcp.tryrehearsal.ai

# Reports
REPORT_PUBLIC_BASE_URL=https://reports.tryrehearsal.ai
STORAGE_BUCKET=student-reports
REPORT_PURPOSE=final
AGENT_API_BASE=https://reports.tryrehearsal.ai
AGENT_SHARED_SECRET=<independent-32+-character-random-secret>
# Legacy synchronous rollback only; the queued path never receives this admin credential.
AGENT_ADMIN_USER=
AGENT_ADMIN_PASS=
AGENT_REPORT_QUEUE=true

# Rate limiting (per token, sliding window) — tool calls allowed per window
MCP_RATE_LIMIT=90
MCP_RATE_WINDOW_SECONDS=60

# Transport hardening
MCP_MAX_BODY_BYTES=262144   # reject requests whose declared or received body is larger (413)
MCP_IP_RATE_LIMIT=1200      # per-IP pre-auth cap; campus users may share one NAT address
MCP_RATE_LIMIT_MAX_KEYS=16384
MCP_REDIS_URL=<tls-redis-url>
MCP_TRUST_PROXY_HEADERS=false
MCP_ALLOWED_HOSTS=moodle-mcp.tryrehearsal.ai
MCP_AUDIT_HMAC_KEY=<independent-long-random-secret>
MCP_REQUIRE_AUDIT=false
# Optional access-request approver relay. Both values are required together. The
# event contains role/campus only, never requester identity; the relay must reject
# stale/replayed X-MCP-Timestamp + X-MCP-Nonce signatures.
MCP_ACCESS_REQUEST_WEBHOOK_URL=
MCP_ACCESS_REQUEST_WEBHOOK_SECRET=

# --- Observability → New Relic (EU, acct 8495484). All inert unless the key is set. ---
# The single switch: set the EU **Ingest - License** key (NOT a User/NRAK or Insights
# key, and it must be the EU-region key for otlp.eu01.nr-data.net) to turn telemetry on.
NEW_RELIC_LICENSE_KEY=<eu-ingest-license-key>
MCP_OTEL_ENDPOINT=https://otlp.eu01.nr-data.net   # EU OTLP; use otlp.nr-data.net for US
# MCP_OTEL_HEADERS=api-key=<k>,x-tenant=<v>        # advanced: overrides the api-key header
MCP_OTEL_TRACES=true          # SERVER span per tool call + mcp.auth span
MCP_OTEL_METRICS=true         # host/process gauges + mcp.tool.calls/.duration/auth counters
MCP_OTEL_LOGS=false           # opt-in log forwarding — enable only once logs are PII-free
MCP_OTEL_METRIC_INTERVAL_MS=60000
MCP_SERVICE_INSTANCE_ID=      # else hostname; set to the Render instance id under scale
# Head sampling for our SERVER spans (0..1). 1.0 = keep all (default). An unsampled
# upstream traceparent NEVER drops our spans below this; a sampled upstream is always
# kept. Lower this only if span volume/cost bites at 5k (error/throughput rates still
# live in the mcp.tool.* metrics, which ignore sampling).
MCP_OTEL_SAMPLE_RATIO=1.0

# --- PII redaction (DPDP) ---
# In-server redaction of TOOL OUTPUT by the MCP server: pseudonymise every student identity to a
# deterministic S_ token before results leave the server. off|shadow|enforce (shadow serves raw +
# logs coverage counts; enforce returns redacted). Requires a DEDICATED >=32-char key, never the
# audit key. See docs/PII_REDACTION_IMPLEMENTATION.md.
MCP_PII_REDACTION_MODE=off
MCP_PII_HMAC_KEY=<dedicated-32+-char-random-secret>

# TrueFoundry AI Gateway is the only production model ingress for the narrative generator
# (AIA-1012/AIA-1386). Production fails closed when it or the required guardrails are absent.
# A pseudonymised direct OpenRouter path remains available only in development. Keep the real
# gateway token in .env.truefoundry.local (gitignored) or the deployment secret store.
#   BASE_URL  = the tenant's OpenAI-compatible gateway endpoint (from the TFY dashboard code snippet)
#   MODEL     = the model id as the gateway exposes it, e.g. "<provider-account>/<model>"
#   GUARDRAILS= the input guardrail "<group>/<config>" (default moodle-pii/pii-redaction); the group
#               is configured to redact email/phone/gov-IDs, NOT the person name (handled by stitch).
TRUEFOUNDRY_API_KEY=<truefoundry-gateway-api-key>
TRUEFOUNDRY_BASE_URL=https://gradelessai.truefoundry.cloud/api/llm/openai
TRUEFOUNDRY_MODEL=<provider-account>/<model>
TRUEFOUNDRY_REQUIRED=0
TRUEFOUNDRY_INPUT_GUARDRAILS=moodle-pii/pii-redaction
TRUEFOUNDRY_OUTPUT_GUARDRAILS=moodle-pii/pii-redaction
TRUEFOUNDRY_PROMPT_INJECTION_GUARDRAIL=
TRUEFOUNDRY_SECRETS_GUARDRAIL=
TRUEFOUNDRY_REQUIRE_ADVANCED_GUARDRAILS=0
TRUEFOUNDRY_REQUEST_TIMEOUT_MS=60000
TRUEFOUNDRY_RETRY_ATTEMPTS=2
TRUEFOUNDRY_RETRY_STATUS_CODES=408,429,500,502,503,504
TRUEFOUNDRY_PROMPT_VERSION=student-report-system/1.0.0
